# Адрес трекера Keitaro (без /admin_api) и ключ Admin API
KEITARO_URL=https://tracker.example.com
KEITARO_API_KEY=

# Что проставлять новым кампаниям. Ищется в Keitaro по имени; если не найдено — создаётся.
# Пустое значение — поле не проставляется. Если у ключа нет прав на раздел,
# кампания создаётся без этого поля, а форма показывает предупреждение.
KEITARO_DOMAIN=
KEITARO_GROUP=
KEITARO_SOURCE=

# Префикс имён кампаний, например test_ivanov_ (пусто — не подставлять)
CAMPAIGN_NAME_PREFIX=
